---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import SEO from "@/components/ui/SEO.astro";
import { colorSwatches, products } from "@/lib/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const priceNumeric = product.price.replace(/[^\d]/g, "");
const baseUrl = Astro.site ?? Astro.url;
const productUrl = new URL(`/products/${product.slug}`, baseUrl);
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", baseUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Products",
      item: new URL("/products", baseUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: product.name,
      item: productUrl.toString(),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{product.name} PS5 Controller | Control RD</title>
    <SEO
      title={`${product.name} PS5 Controller | Control RD`}
      description={product.description}
      image={product.image.src}
      type="product"
      price={priceNumeric || undefined}
      structuredData={breadcrumbStructuredData}
    />
    <ClientRouter />
  </head>
  <body class="m-0 bg-white text-ink font-text">
    <header
      class="sticky top-0 z-20 border-b border-silver-mist bg-fog/85 backdrop-blur-xl"
    >
      <nav
        class="mx-auto flex h-[52px] w-[min(100%-32px,1200px)] items-center justify-between"
        aria-label="Main navigation"
      >
        <a class="text-sm font-bold" href="/">Control RD</a>
        <div class="hidden gap-6 text-xs text-slate sm:flex">
          <a class="hover:text-ink" href="/products">Products</a>
          <a class="hover:text-ink" href="/#about">About</a>
          <a class="hover:text-ink" href="/#order">Order</a>
        </div>
        <a
          class="inline-flex min-h-9 items-center justify-center rounded-full bg-azure px-[18px] py-2 text-[17px] leading-none text-white"
          href="/#order">Buy</a
        >
      </nav>
    </header>

    <main class="mx-auto w-[min(100%-32px,1200px)] py-16 sm:py-[84px]">
      <section
        class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_0.9fr]"
        aria-labelledby="product-title"
        data-color-container
      >
        <div
          class="grid min-h-0 place-items-center rounded-[28px] bg-white p-[clamp(20px,4vw,44px)] lg:min-h-[640px]"
        >
          {
            product.colors.map((color, index) => (
              <Image
                data-color-image={color}
                class:list={["max-h-[560px] w-full object-contain drop-shadow-2xl", index !== 0 && "hidden"]}
                src={product.colorImages?.[color] ?? product.image}
                alt={`${product.name} in ${color}`}
                widths={[480, 720, 960, 1200, 1400]}
                sizes="(max-width: 860px) 100vw, 55vw"
                loading="eager"
              />
            ))
          }
        </div>
        <div class="rounded-[28px] bg-white p-[clamp(28px,5vw,56px)]">
          <p class="mb-2.5 text-[17px] font-semibold text-graphite">
            {product.eyebrow}
          </p>
          <h1
            id="product-title"
            class="mb-[18px] font-display text-[clamp(48px,8vw,86px)] font-bold leading-[1.04] tracking-[-0.022em]"
          >
            {product.name}
          </h1>
          <p class="mb-7 text-xl leading-[1.45] text-graphite">
            {product.description}
          </p>
          <p class="mb-7 text-[28px] font-bold">{product.price}</p>
          <h2 class="mb-3.5 mt-[34px] font-display text-[28px] font-semibold">
            Features
          </h2>
          <ul
            class="grid gap-2.5 pl-5 text-[17px] leading-[1.45] text-graphite"
          >
            {product.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <h2 class="mb-3.5 mt-[34px] font-display text-[28px] font-semibold">
            Available colors
          </h2>
          <div
            class="grid grid-cols-6 w-fit gap-2.5 pl-5 text-[17px] leading-[1.45] text-graphite"
          >
            {
              product.colors.map((color, colorIndex) => (
                <button
                  type="button"
                  class:list={[
                    "h-7 w-7 rounded-full border-[3px] transition-all hover:scale-110 cursor-pointer ring-2 ring-ink/30",
                    colorIndex === 0 && "ring-2 ring-ink/30",
                  ]}
                  aria-label={`Selected ${color} color`}
                  style={`background:${colorSwatches[color] ?? "#e8e8ed"} `}
                  data-color={color}
                  data-image={product.colorImages?.[color]?.src ?? ""}
                ></button>
              ))
            }
          </div>
          <div
            class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center"
          >
            <a
              class="inline-flex min-h-9 items-center justify-center rounded-full bg-azure px-[18px] py-2 text-[17px] leading-none text-white"
              href="/#order">Request this controller</a
            >
            <a class="text-[#0066cc]" href="/products">View all products</a>
          </div>
        </div>
      </section>
    </main>

    <footer
      class="mx-auto w-[min(100%-32px,1200px)] border-t border-silver-mist py-6 text-xs text-graphite"
    >
      Control RD. Original PS5 controller sourcing, pickup, and delivery
      coordination.
    </footer>
  </body>
</html>

<script>
  import { colorSwitcher } from "@/lib/colorSwitcher";
  colorSwitcher();
</script>
