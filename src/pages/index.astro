---
import "@/styles/global.css";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import ProductShowcase from "@/components/sections/ProductShowcase.astro";
import About from "@/components/sections/About.astro";
import CTA from "@/components/sections/CTA.astro";
import OrderForm from "@/components/sections/OrderForm.astro";
---

<BaseLayout
  title="Control RD | PS5 Controllers in Dominican Republic"
  description="Original Sony PS5 DualSense controllers available in Dominican Republic. Fast local delivery, same-day coordination in Santo Domingo. Limited colors and DualSense Edge pro controller."
>
  <Header />

  <main id="top">
    <Hero />
    <ProductShowcase />
    <About id="about" />
    <CTA />
    <OrderForm id="order" />
  </main>

  <Footer />
</BaseLayout>