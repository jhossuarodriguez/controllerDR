---
interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: "website" | "product";
  price?: string;
  currency?: string;
  availability?: "in_stock" | "out_of_stock" | "preorder";
}

const {
  title,
  description,
  image = "/og-default.png",
  url = Astro.url,
  type = "website",
  price,
  currency = "DOP",
  availability = "in_stock",
} = Astro.props;

const baseUrl = Astro.site || Astro.url;
const urlObj = typeof url === "string" ? new URL(url, baseUrl) : url;
const canonicalURL = new URL(urlObj.pathname, baseUrl);
const socialImageURL = new URL(image, baseUrl);
---

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- Primary Meta Tags -->
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Control RD" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content="Control RD" />
<meta property="og:locale" content="es_DO" />

{type === "product" && price && (
  <meta property="product:price:amount" content={price} />
)}
{type === "product" && (
  <meta property="product:price:currency" content={currency} />
)}
{type === "product" && (
  <meta property="product:availability" content={availability} />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL} />

<!-- JSON-LD Structured Data -->
{type === "product" && price && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    name: title,
    description: description,
    image: socialImageURL.toString(),
    offers: {
      "@type": "Offer",
      price: price,
      priceCurrency: currency,
      availability: `https://schema.org/${availability === "in_stock" ? "InStock" : availability === "out_of_stock" ? "OutOfStock" : "PreOrder"}`,
      url: canonicalURL.toString(),
    },
    seller: {
      "@type": "Organization",
      name: "Control RD",
      url: Astro.url.origin,
    },
  })} />
)}

{type === "website" && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Control RD",
    description: description,
    url: Astro.url.origin,
    logo: new URL("/logo.svg", Astro.url.origin).toString(),
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "sales",
      availableTime: { dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] },
    },
    areaServed: {
      "@type": "Country",
      name: "Dominican Republic",
    },
    sameAs: [],
  })} />
)}