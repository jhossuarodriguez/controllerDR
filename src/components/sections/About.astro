---
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section
  class="bg-white px-4 py-24 max-md:py-[72px]"
  id={id}
  aria-labelledby="about-title"
>
  <div class="mx-auto w-[min(100%,1200px)]">
    <p class="mb-3 text-sm font-semibold text-graphite">About us</p>
    <h2
      class="mb-[42px] max-w-[780px] font-display text-[clamp(38px,6vw,64px)] font-bold leading-[1.07] tracking-[-0.9px]"
      id="about-title"
    >
      Local store. Console-first service.
    </h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-[0.95fr_1.05fr]">
      <div
        class="rounded-[28px] bg-fog p-[clamp(28px,5vw,48px)] text-[17px] leading-[1.47] text-graphite"
      >
        <p>
          Control RD is built for PlayStation players in the Dominican
          Republic who want reliable gear without guessing if it is
          original, compatible, or ready to ship.
        </p>
        <p class="mt-[18px]">
          We verify every controller before delivery coordination and help
          customers choose the right color, bundle, and pickup or delivery
          option for their city.
        </p>
      </div>
      <div
        class="grid min-h-[380px] place-items-center rounded-[28px] bg-obsidian p-8 text-center text-white"
      >
        <div>
          <strong
            class="block font-display text-[clamp(76px,12vw,140px)] leading-[0.9] tracking-[-3px]"
            >24h</strong
          >
          <p>Fast order coordination in Santo Domingo.</p>
        </div>
      </div>
    </div>
  </div>
</section>