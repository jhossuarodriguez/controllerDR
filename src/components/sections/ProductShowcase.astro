---
import { Image } from "astro:assets";
import { products } from "@/lib/products";

const landingProducts = products.slice(0, 3);

if (landingProducts.length === 0) {
  throw new Error("Products data not available");
}

const colorSwatches: Record<string, string> = {
  White: "#ffffff",
  "Midnight Black":
    "linear-gradient(135deg, #09090A 0%, #111113 60%, #222226 100%)",
  "Cosmic Red": "#c91832",
  "Starlight Blue": "#8fb7e8",
  "Nova Pink": "#e8a2ba",
  "Galactic Purple": "#5d4b8c",
  "Chroma Indigo":
    "linear-gradient(135deg, #1A0B5E 0%, #3F00FF 35%, #6900C6 70%, #9A00E6 100%)",
  "Chroma Pearl":
    "linear-gradient(135deg, #FDFBF7 0%, #EAE5D9 40%, #E3E9E2 75%, #F5E6EC 100%)",
  "Chroma Teal":
    "linear-gradient(135deg, #004B49 0%, #008080 35%, #00A3A3 70%, #76FFD4 100%)",
  "Cobalt Blue":
    "linear-gradient(135deg, #001F54 0%, #0047AB 50%, #0074E4 100%)",
  "Remix Green":
    "linear-gradient(180deg, #111113 0%, #111113 45%, #9dcb36 45%, #9dcb36 100%)",
  "Rhythm Blue":
    "linear-gradient(180deg, #111113 0%, #111113 45%, #00A2E8 45%, #00A2E8 100%)",
  "Sterling Silver": "#98a2b4",
  "Tecno Red":
    "linear-gradient(180deg, #111113 0%, #111113 45%, #e31a35 45%, #e31a35 100%)",
};
---

<section
  class="bg-fog px-4 py-24 max-md:py-[72px]"
  id="sell"
  aria-labelledby="sell-title"
>
  <div class="mx-auto w-[min(100%,1200px)]">
    <p class="mb-3 text-sm font-semibold text-graphite">What we sell</p>
    <h2
      class="mb-[42px] max-w-[780px] font-display text-[clamp(38px,6vw,64px)] font-bold leading-[1.07] tracking-[-0.9px]"
      id="sell-title"
    >
      Controllers for every kind of player.
    </h2>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        landingProducts.map((product) => (
          <article class="min-h-[260px] rounded-[28px] bg-white p-7 transition hover:-translate-y-1.5">
            <a href={`/products/${product.slug}`}>
              <Image
                class="mb-6 block h-[120px] w-full object-contain"
                src={product.image}
                alt={product.imageAlt}
                width={280}
                height={200}
                widths={[200, 280, 360]}
                sizes="(max-width: 820px) 100vw, 33vw"
              />

              <h3 class="mb-3 font-display text-[28px] font-semibold leading-[1.15] tracking-[-0.5px]">
                {product.name}
              </h3>
            </a>

            <p class="m-0 text-[17px] leading-[1.47] text-graphite">
              {product.description}
            </p>

            <div class="mt-7 text-xl font-semibold">{product.price}</div>
            <div
              class="mt-5 gap-2 flex flex-wrap flex-1"
              aria-label={`${product.name} colors`}
            >
              {product.colors.map((color, colorIndex) => (
                <button
                  type="button"
                  class:list={[
                    "h-7 w-7 rounded-full border-[3px] transition-all hover:scale-110 cursor-pointer border-ink/80 ring-2 ring-ink/30",
                    colorIndex === 0 && "ring-2 ring-ink/30",
                  ]}
                  aria-label={`Select ${color} color`}
                  style={`background:${colorSwatches[color] ?? "#e8e8ed"}`}
                  data-color={color}
                />
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-color]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const parent = btn.parentElement;
      parent?.querySelectorAll("[data-color]").forEach((b: Element) => {
        b.classList.remove("ring-4", "ring-ink/20");
      });
      btn.classList.add("ring-4", "ring-ink/20");
    });
  });
</script>
