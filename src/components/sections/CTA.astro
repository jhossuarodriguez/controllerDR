---
import { Image } from "astro:assets";
import { products } from "@/lib/products";

const ctoProduct = products[3];

if (!ctoProduct) {
  throw new Error("Products data not available");
}
---

<section
  class="bg-[linear-gradient(184deg,#1d1d1f_0%,rgba(185,28,28,0.72)_48%,rgba(239,68,68,0.42)_100%)] px-4 py-24 text-center text-white max-md:py-[72px]"
  aria-labelledby="cto-title"
>
  <div
    class="mx-auto grid min-h-[520px] w-[min(100%,1200px)] place-items-center"
  >
    <div>
      <Image
        class="mx-auto mb-7 block h-auto w-[min(420px,86vw)]"
        src={ctoProduct.image}
        alt={ctoProduct.imageAlt}
        width={420}
        height={280}
        widths={[280, 420, 640]}
        sizes="(max-width: 520px) 86vw, 420px"
      />
      <h2
        class="mx-auto mb-[18px] max-w-[860px] font-display text-[clamp(44px,8vw,80px)] leading-[1.04] tracking-[-1.6px]"
        id="cto-title"
      >
        Ready for player two?
      </h2>
      <p class="mx-auto mb-[26px] max-w-[620px] text-xl leading-[1.4]">
        Upgrade your setup today with an original PS5 controller and local
        Dominican support from first message to delivery.
      </p>
      <a
        class="inline-flex min-h-9 items-center justify-center rounded-full bg-obsidian px-[18px] py-2 text-[17px] leading-none text-white transition hover:-translate-y-px"
        href="#order">Order now</a
      >
    </div>
  </div>
</section>